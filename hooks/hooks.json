{
  "description": "Publish Codex lifecycle events to agent-status.",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/codex-plugin/emitter.py\" hook --host-pid \"$PPID\""}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/codex-plugin/emitter.py\" hook --host-pid \"$PPID\""}]}],
    "PreToolUse": [{"hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/codex-plugin/emitter.py\" hook --host-pid \"$PPID\""}]}],
    "PermissionRequest": [{"hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/codex-plugin/emitter.py\" hook --host-pid \"$PPID\""}]}],
    "PostToolUse": [{"hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/codex-plugin/emitter.py\" hook --host-pid \"$PPID\""}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/codex-plugin/emitter.py\" hook --host-pid \"$PPID\""}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/codex-plugin/emitter.py\" hook --host-pid \"$PPID\"", "timeout": 3}]}]
  }
}
